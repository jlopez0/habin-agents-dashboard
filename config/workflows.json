[
  {
    "id": "standard",
    "name": "Flujo diario estándar",
    "description": "Flujo típico con la sesión principal: plan, fase, revisión y commit.",
    "trigger": "Javier pide una tarea en el repo (Sonnet por defecto; Opus si toca decidir).",
    "source": "habin-agents-gang/README.md",
    "steps": [
      {
        "id": "s",
        "type": "start",
        "label": "Javier pide la tarea",
        "detail": "La sesión delega sola según la descripción de cada agente, o se fuerza con @agente."
      },
      {
        "id": "a",
        "type": "agent",
        "label": "Plan por fases",
        "agentId": "arquitecto",
        "detail": "Escribe docs/PLAN_<TEMA>.md con agente y modelo por fase."
      },
      {
        "id": "b",
        "type": "agent",
        "label": "Ejecuta la fase N",
        "agentId": "implementador",
        "detail": "Build, lint y tests antes de terminar."
      },
      {
        "id": "c",
        "type": "agent",
        "label": "Revisa el diff",
        "agentId": "revisor",
        "detail": "Contexto limpio; informe 🔴🟡⚪."
      },
      {
        "id": "d",
        "type": "decision",
        "label": "¿Veredicto?"
      },
      {
        "id": "e",
        "type": "human",
        "label": "Commit",
        "detail": "Un commit pequeño y con sentido; el push es siempre manual."
      },
      {
        "id": "f",
        "type": "end",
        "label": "Fase cerrada"
      }
    ],
    "edges": [
      {
        "from": "s",
        "to": "a",
        "kind": "flow"
      },
      {
        "from": "a",
        "to": "b",
        "kind": "delegation",
        "label": "plan"
      },
      {
        "from": "b",
        "to": "c",
        "kind": "review",
        "label": "diff"
      },
      {
        "from": "c",
        "to": "d",
        "kind": "flow"
      },
      {
        "from": "d",
        "to": "e",
        "kind": "approval",
        "label": "LISTO"
      },
      {
        "from": "d",
        "to": "b",
        "kind": "loop",
        "label": "NO LISTO",
        "loop": true
      },
      {
        "from": "e",
        "to": "f",
        "kind": "flow"
      }
    ]
  },
  {
    "id": "jefe-loop",
    "name": "Modo jefe: bucle por fase",
    "description": "El jefe ejecuta un plan completo delegando fase a fase, con revisión y un commit por fase.",
    "trigger": "claude --agent jefe --permission-mode acceptEdits en el repo.",
    "source": "habin-agents-gang/agents/jefe.md",
    "steps": [
      {
        "id": "s",
        "type": "start",
        "label": "Javier lanza al jefe"
      },
      {
        "id": "r",
        "type": "agent",
        "label": "Lee el plan y resume el estado",
        "agentId": "jefe",
        "detail": "Máximo 8 líneas; espera el OK de Javier."
      },
      {
        "id": "ok",
        "type": "human",
        "label": "OK de Javier",
        "detail": "Punto de parada inicial."
      },
      {
        "id": "amb",
        "type": "decision",
        "label": "¿Fase ambigua?"
      },
      {
        "id": "arq",
        "type": "agent",
        "label": "Parte la fase en subtareas",
        "agentId": "arquitecto",
        "detail": "Cada subtarea con su agente."
      },
      {
        "id": "del",
        "type": "agent",
        "label": "Delega la subtarea",
        "agentId": "jefe",
        "detail": "Prefiere los agentes del proyecto sobre los genéricos; encargos autocontenidos."
      },
      {
        "id": "exe",
        "type": "agent",
        "label": "Ejecuta",
        "agentId": "implementador",
        "detail": "Agente de código del proyecto o implementador; mecanico, redactor-es o release-movil según el tipo."
      },
      {
        "id": "rev",
        "type": "agent",
        "label": "Cierra la fase",
        "agentId": "revisor",
        "detail": "Veredicto LISTO / NO LISTO."
      },
      {
        "id": "dec",
        "type": "decision",
        "label": "¿LISTO y tests en verde?"
      },
      {
        "id": "stop",
        "type": "human",
        "label": "Punto de parada",
        "detail": "Irreversible o fuera del repo, decisión de producto, 2 fallos del mismo agente, 2 vueltas sin pasar, hito con fecha."
      },
      {
        "id": "com",
        "type": "agent",
        "label": "Commit por fase + bitácora",
        "agentId": "jefe",
        "detail": "git add + commit; nunca push. Resumen ≤5 líneas."
      },
      {
        "id": "more",
        "type": "decision",
        "label": "¿Más fases?"
      },
      {
        "id": "end",
        "type": "end",
        "label": "Plan completado"
      }
    ],
    "edges": [
      {
        "from": "s",
        "to": "r",
        "kind": "flow"
      },
      {
        "from": "r",
        "to": "ok",
        "kind": "flow"
      },
      {
        "from": "ok",
        "to": "amb",
        "kind": "flow"
      },
      {
        "from": "amb",
        "to": "arq",
        "kind": "delegation",
        "label": "sí"
      },
      {
        "from": "amb",
        "to": "del",
        "kind": "flow",
        "label": "no"
      },
      {
        "from": "arq",
        "to": "del",
        "kind": "flow",
        "label": "subtareas"
      },
      {
        "from": "del",
        "to": "exe",
        "kind": "delegation",
        "label": "encargo"
      },
      {
        "from": "exe",
        "to": "rev",
        "kind": "review",
        "label": "fase hecha"
      },
      {
        "from": "rev",
        "to": "dec",
        "kind": "flow"
      },
      {
        "from": "dec",
        "to": "com",
        "kind": "approval",
        "label": "LISTO"
      },
      {
        "from": "dec",
        "to": "exe",
        "kind": "loop",
        "label": "NO LISTO (máx. 2 vueltas)",
        "loop": true
      },
      {
        "from": "dec",
        "to": "stop",
        "kind": "escalation",
        "label": "sigue sin pasar"
      },
      {
        "from": "com",
        "to": "more",
        "kind": "flow"
      },
      {
        "from": "more",
        "to": "amb",
        "kind": "loop",
        "label": "sí",
        "loop": true
      },
      {
        "from": "more",
        "to": "end",
        "kind": "flow",
        "label": "no"
      }
    ]
  },
  {
    "id": "escalation",
    "name": "Escalado de fallos",
    "description": "Cuando el implementador no consigue pasar los tests, no insiste: escala.",
    "trigger": "Tests fallan dos veces por lo mismo.",
    "source": "habin-agents-gang/CLAUDE.md",
    "steps": [
      {
        "id": "s",
        "type": "start",
        "label": "Fase en curso"
      },
      {
        "id": "imp",
        "type": "agent",
        "label": "Implementa y prueba",
        "agentId": "implementador"
      },
      {
        "id": "dec",
        "type": "decision",
        "label": "¿Falla 2 veces lo mismo?"
      },
      {
        "id": "diag",
        "type": "agent",
        "label": "Devuelve el diagnóstico",
        "agentId": "implementador",
        "detail": "Para y devuelve el diagnóstico."
      },
      {
        "id": "arq",
        "type": "agent",
        "label": "Decide la salida",
        "agentId": "arquitecto",
        "detail": "Reformula el plan o la subtarea."
      },
      {
        "id": "ok",
        "type": "end",
        "label": "Fase continúa"
      }
    ],
    "edges": [
      {
        "from": "s",
        "to": "imp",
        "kind": "flow"
      },
      {
        "from": "imp",
        "to": "dec",
        "kind": "flow"
      },
      {
        "from": "dec",
        "to": "ok",
        "kind": "flow",
        "label": "no"
      },
      {
        "from": "dec",
        "to": "diag",
        "kind": "escalation",
        "label": "sí"
      },
      {
        "from": "diag",
        "to": "arq",
        "kind": "escalation",
        "label": "escala"
      },
      {
        "from": "arq",
        "to": "imp",
        "kind": "loop",
        "label": "plan ajustado",
        "loop": true
      }
    ]
  },
